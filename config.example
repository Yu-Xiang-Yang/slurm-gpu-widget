# 复制到 ~/.config/cluster-widget/config 后修改（install.sh 会自动复制一份）
# Copy to ~/.config/cluster-widget/config and edit (install.sh does this for you)

# 集群名，显示在组件标题和菜单栏上；留空显示 "GPU 队列"
# Cluster name shown in the widget title and menu bar; empty = default title
CLUSTER_NAME=""

# Tunnelblick 里显示的配置名；留空则不检测 VPN，直接 ssh
# Tunnelblick configuration name; empty = skip VPN detection and ssh directly
TB_CONFIG="my-vpn"

# ssh 目标，推荐填 ~/.ssh/config 里的 Host 别名（HostName/User/IdentityFile/ProxyJump 写在那里）
# ssh target, preferably a Host alias defined in ~/.ssh/config
SSH_HOST="cluster"

# VPN 未连接时是否自动让 Tunnelblick 连接（1=是，0=否）
# Auto-connect Tunnelblick when the VPN is down (1=yes, 0=no)
AUTO_CONNECT=1
CONNECT_TIMEOUT=30

# 只显示这些分区，逗号分隔；留空显示全部
# Comma-separated partitions to display; empty = all
PARTITIONS=""

# 1=只显示有 GPU 的分区（不显示 CPU）；0=CPU 和 GPU 都显示
# 1 = GPU partitions only; 0 = show CPU and GPU
GPU_ONLY=1

# 1=在每个分区下列出节点名及其 GPU/CPU 占用；0=只显示分区汇总
# 1 = list node names with per-node GPU/CPU usage under each partition; 0 = summary only
SHOW_NODES=0

# 界面语言：zh=中文，en=English，auto=跟随系统语言
# Interface language: zh, en, or auto (follow the macOS language)
UI_LANG="auto"

# 各分区 GPU 型号标注（Slurm 的 Gres 未写型号时手动填写），分号分隔
# Per-partition GPU model label (for clusters whose Gres carries no type), semicolon-separated
GPU_MODELS=""   # e.g. "gpu=NVIDIA A100 80GB;compute2=NVIDIA V100 32GB"

# 1=经登录节点并行 ssh 到各 GPU 节点执行 nvidia-smi，显示每张卡的型号、显存占用和利用率
#   需要登录节点能免密 ssh 到计算节点；启用 pam_slurm_adopt 的集群仅允许登录有作业的节点
# 1 = query nvidia-smi on each GPU node (parallel ssh from the login node) for per-GPU model, memory and utilisation
#   requires password-less ssh from the login node to compute nodes (pam_slurm_adopt restricts this to nodes running your jobs)
GPU_DETAIL=0
GPU_DETAIL_TIMEOUT=6

# 1=显示自己正在运行的作业：已运行时长/时限、节点，以及该作业每张卡的显存占用和利用率
#   （在作业分配内执行 srun --overlap nvidia-smi，不需要 ssh 到计算节点）
# 1 = list your running jobs with elapsed/limit, nodes, and per-GPU memory and utilisation
#   (nvidia-smi is executed inside the job allocation via srun --overlap; no ssh to compute nodes)
SHOW_MY_JOBS=1

# 作业显存/利用率的查询间隔（秒）。集群数据每 15 秒刷新一次，作业 GPU 数据在此间隔内复用缓存，
# 以免每次刷新都创建作业步（srun）
# Interval (s) between per-job GPU queries; cached in between to avoid creating a job step on every refresh
JOB_GPU_INTERVAL=30
